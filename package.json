{
  "name": "tulsa-district-water-safety-web-platform",
  "private": true,
  "type": "module",
  "description": "Static Bobber water-safety site for USACE Tulsa District",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "update:pdf-meta": "node scripts/update-pdf-meta.mjs",
    "check:pdf-meta": "node scripts/update-pdf-meta.mjs --check",
    "update:image-dimensions": "node scripts/update-image-dimensions.mjs",
    "check:pdf-budget": "node scripts/check-pdf-budget.mjs",
    "report:pdf-accessibility": "node scripts/report-pdf-accessibility.mjs --write",
    "check:html": "html-validate index.html grown-ups.html 404.html accessibility.html poster.html",
    "update:qr": "node scripts/make-qr.mjs",
    "check:qr": "node scripts/make-qr.mjs --check",
    "update:teacher-pack": "node scripts/make-teacher-pack.mjs",
    "check:teacher-pack": "node scripts/make-teacher-pack.mjs --check",
    "update:resource-schema": "node scripts/update-resource-schema.mjs",
    "check:resource-schema": "node scripts/update-resource-schema.mjs --check",
    "update:library": "node scripts/render-library.mjs",
    "check:library": "node scripts/render-library.mjs --check",
    "update:partials": "node scripts/apply-partials.mjs",
    "check:partials": "node scripts/apply-partials.mjs --check",
    "check:css": "node scripts/check-css.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:globals": "node scripts/check-globals.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:site-url": "node scripts/check-site-url.mjs",
    "update:site-url": "node scripts/update-site-url.mjs",
    "update:sitemap": "node scripts/update-sitemap.mjs",
    "check:sitemap": "node scripts/update-sitemap.mjs --check",
    "check:live": "node scripts/check-live.mjs",
    "update:precache": "node scripts/update-precache.mjs",
    "check:precache": "node scripts/update-precache.mjs --check",
    "bump:version": "node scripts/bump-version.mjs",
    "check": "npm run check:versions && npm run check:globals && npm run check:content && npm run check:translations && npm run check:metadata && npm run check:site && npm run check:site-url && npm run check:resource-schema && npm run check:library && npm run check:sitemap && npm run check:qr && npm run check:teacher-pack && npm run check:html && npm run check:css && npm run check:budgets && npm run check:partials && npm run check:precache && npm run check:pdf-meta && npm run check:pdf-budget"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "html-validate": "^11.21.1",
    "image-size": "^2.0.2",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.33",
    "qrcode": "^1.5.4"
  }
}
